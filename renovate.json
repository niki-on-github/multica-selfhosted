{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "1 day",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^upstream\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "New upstream release -> commit to main -> build.yml builds the patched images",
      "matchDepNames": ["multica-ai/multica"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Action bumps are tested by the build they trigger",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}
